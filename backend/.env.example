APP_NAME=Piquantum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=piquantum_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En local se deja MAIL_MAILER=log (los correos se escriben en storage/logs/laravel.log).
# En el hosting (DonDominio): MAIL_MAILER=smtp y los datos SMTP de la cuenta, que indica el panel
# de DonDominio en la sección Correo. La contraseña NUNCA se sube al repositorio.
#   MAIL_HOST=<servidor SMTP indicado por DonDominio>
#   MAIL_PORT=465 con MAIL_SCHEME=smtps   (o MAIL_PORT=587 con STARTTLS, según el panel)
#   MAIL_USERNAME=<la dirección completa de la cuenta>
# El remitente debe ser la MISMA cuenta para que SPF/DKIM del dominio validen el correo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="tienda@example.com"
MAIL_FROM_NAME="Piquantum (prototipo)"
# Buzón de la tienda que recibe los avisos de soporte (por defecto, MAIL_FROM_ADDRESS)
SHOP_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TPV Virtual de Redsys. Esta es la clave PÚBLICA del comercio de pruebas de Redsys (999008881-001, entorno TEST).
# En un comercio real, la clave se obtiene del Portal de Redsys y nunca se sube al repositorio.
# Recuerda: APP_URL debe ser la URL pública en el hosting para que Redsys pueda enviar las notificaciones.
REDSYS_API_KEY=TEST_OTk5MDA4ODgxXzAwMV9zcTdIanJVT0JmS21DNTc2SUxnc2tENXNyVTg3MGdKNw
