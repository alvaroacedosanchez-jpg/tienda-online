# Plantilla de variables para el entorno LOCAL (Docker).
# Uso: cp .env.example .env  y cambia los valores en .env (que NO se sube a git).
# Nunca pongas aquí las credenciales del hosting de DonDominio: esas solo viven en el servidor.

# --- MySQL (las lee la imagen oficial de MySQL al crear la BBDD por primera vez) ---
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=tecladosonline
MYSQL_USER=tienda
MYSQL_PASSWORD=1234

# --- Puertos en tu ordenador (cámbialos si ya están ocupados) ---
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
